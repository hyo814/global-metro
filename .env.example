# Mobility Database — https://mobilitydatabase.org 가입 후 계정 페이지에서 복사
MOBILITY_REFRESH_TOKEN=

# 한국어 변환 — https://console.anthropic.com
# 없어도 동작한다. 그 경우 현지 표기 그대로 보인다.
ANTHROPIC_API_KEY=

# 도쿄메트로 등 일본 철도 — https://developer.odpt.org (관리자 승인 필요)
ODPT_CONSUMER_KEY=

# 한국 버스 — https://www.data.go.kr (일반 인증키, 디코딩된 쪽)
DATA_GO_KR_KEY=

# 서버 배포(docker compose)용 — 로컬 실행에는 필요 없다
# 도메인이 없으면 <서버IP>.sslip.io (예: 5.75.1.2.sslip.io)
DOMAIN=
AUTH_USER=
# docker run --rm caddy:2 caddy hash-password -p '비밀번호' | base64
AUTH_HASH_B64=
